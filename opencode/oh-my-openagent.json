    "sisyphus-junior": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4-mini"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.5",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high"
    },
    "artistry": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "quick": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.6-luna",
