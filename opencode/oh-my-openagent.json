{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      401,
      402,
      403,
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 5,
    "cooldown_seconds": 15,
    "timeout_seconds": 20,
    "notify_on_fallback": true
  },
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "openai": 5
    }
  },
  "experimental": {
    "aggressive_truncation": true
  },
  "notification": {
    "force_enable": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "hephaestus": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "oracle": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "librarian": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "explore": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "prometheus": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "metis": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "momus": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "atlas": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "ultrabrain": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "artistry": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "quick": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "unspecified-low": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "unspecified-high": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    },
    "writing": {
      "model": "openai/gpt-5-5-fast",
      "variant": "xhigh"
    }
  }
}
