{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      401,
      402,
      403,
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 5,
    "cooldown_seconds": 15,
    "timeout_seconds": 20,
    "notify_on_fallback": true
  },
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "openai": 3,
      "opencode": 3,
      "kimi-for-coding": 6,
      "opencode-go": 8
    }
  },
  "experimental": {
    "aggressive_truncation": true
  },
  "notification": {
    "force_enable": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "agents": {
    "sisyphus": {
      "model": "opencode/claude-opus-4-7",
      "variant": "max",
      "fallback_models": [
        "opencode-go/kimi-k2.6",
        "kimi-for-coding/k2p6",
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        },
        "opencode-go/glm-5.1"
      ],
      "ultrawork": {
        "model": "opencode/claude-opus-4-7",
        "variant": "max",
        "fallback_models": [
          "opencode-go/kimi-k2.6",
          "kimi-for-coding/k2p6",
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          }
        ]
      }
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        {
          "model": "opencode/claude-opus-4-7",
          "variant": "max"
        },
        "opencode-go/glm-5.1"
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        "opencode-go/qwen3.6-plus",
        "opencode-go/minimax-m3",
        "opencode/claude-haiku-4-5"
      ]
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        "opencode-go/qwen3.6-plus",
        "opencode-go/minimax-m3",
        "opencode/claude-haiku-4-5"
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "opencode-go/kimi-k2.6",
        "kimi-for-coding/k2p6",
        "opencode/gpt-5-nano"
      ]
    },
    "prometheus": {
      "model": "opencode/claude-opus-4-7",
      "variant": "max",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        },
        "opencode-go/kimi-k2.6",
        "kimi-for-coding/k2p6",
        "opencode-go/glm-5.1"
      ]
    },
    "metis": {
      "model": "opencode/claude-sonnet-4-6",
      "fallback_models": [
        {
          "model": "opencode/claude-opus-4-7",
          "variant": "max"
        },
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        },
        "opencode-go/kimi-k2.6",
        "kimi-for-coding/k2p6"
      ]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "opencode/claude-opus-4-7",
          "variant": "max"
        },
        "opencode-go/glm-5.1"
      ]
    },
    "atlas": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "opencode/claude-sonnet-4-6",
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        },
        "opencode-go/minimax-m3"
      ]
    },
    "sisyphus-junior": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "opencode/claude-sonnet-4-6",
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        },
        "opencode-go/minimax-m3"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode-go/qwen3.6-plus"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "artistry": {
      "model": "opencode/claude-opus-4-7",
      "variant": "max",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "opencode/claude-haiku-4-5",
        "opencode-go/minimax-m3"
      ]
    },
    "unspecified-low": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "opencode/claude-sonnet-4-6",
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        }
      ]
    },
    "unspecified-high": {
      "model": "opencode/claude-opus-4-7",
      "variant": "max",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        },
        "opencode-go/kimi-k2.6",
        "kimi-for-coding/k2p6",
        "opencode-go/glm-5.1"
      ]
    },
    "writing": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        "opencode/claude-sonnet-4-6",
        "opencode-go/minimax-m3"
      ]
    }
  }
}
