{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      401,
      402,
      403,
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 5,
    "cooldown_seconds": 15,
    "timeout_seconds": 20,
    "notify_on_fallback": true
  },
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "openai": 3,
      "anthropic": 3,
      "opencode": 6,
      "google": 2
    }
  },
  "experimental": {
    "aggressive_truncation": true
  },
  "notification": {
    "force_enable": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "max_members": 8,
    "tmux_visualization": true
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "claude_code": {
    "plugins": false,
    "skills": false
  },
  "codegraph": {
    "enabled": true,
    "install_dir": "/Users/aslaii/.omo/codegraph"
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        }
      ],
      "ultrawork": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      }
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        }
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4-nano"
      ]
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "fallback_models": [
        "openai/gpt-5.4-nano"
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "fallback_models": [
        "openai/gpt-5-nano"
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "metis": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-sol",
          "variant": "xhigh"
        }
      ]
    },
    "atlas": {
