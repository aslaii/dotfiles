  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      401,
      402,
      403,
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 5,
    "cooldown_seconds": 15,
    "timeout_seconds": 20,
    "notify_on_fallback": true
  },
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "openai": 3,
      "anthropic": 3,
      "opencode": 6,
      "google": 2
    }
  },
  "experimental": {
    "aggressive_truncation": true
  },
