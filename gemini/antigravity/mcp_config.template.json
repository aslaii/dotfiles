{
    "mcpServers": {
        "n8n-mcp": {
            "serverUrl": "https://api.n8n-mcp.com/mcp",
            "headers": {
                "Authorization": "Bearer ${N8N_MCP_TOKEN}"
            }
        },
        "chrome-devtools": {
            "command": "/opt/homebrew/bin/npx",
            "args": ["-y", "chrome-devtools-mcp@latest"],
            "env": {
                "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            }
        }
    }
}
