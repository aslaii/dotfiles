{
  "herdr": {
    "PreInvocation": [
      {
        "command": "bash '/Users/aslaii/.gemini/config/hooks/herdr-agent-state.sh' session",
        "timeout": 10,
        "type": "command"
      }
    ]
  },
  "moshi-hook": {
    "PreInvocation": [
      {
        "command": "'/opt/homebrew/bin/moshi-hook' antigravity-hook PreInvocation",
        "timeout": 5,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "'/opt/homebrew/bin/moshi-hook' antigravity-hook Stop",
        "timeout": 5,
        "type": "command"
      }
    ],
    "enabled": true
  }
}