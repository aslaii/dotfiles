# Only reviewed portable configuration and source resources belong here.
*
!.gitignore
!README.md
!omo.jsonc
!restore.json
!restore.mjs
!restore.test.js
!config.test.js
!launch.sh
!isolation.test.js
!fast.mjs
!fast.test.js
!agent/
!agent/settings.json
!agent/hooks.json
!agent/extensions/
!agent/extensions/herdr-presence.js
!agent/extensions/comment-checker.js
!comment-checker.test.js
!comment-checker-qa.mjs
!herdr-presence.test.js
!rules/
!rules/**

# Never snapshot credentials, package installations, or generated state.
**/.git/
**/node_modules/
**/__pycache__/
**/.DS_Store
**/auth.json
**/credentials.json
**/.env
**/.env.*
**/*.log
**/*.pyc
**/*.bak
**/*.backup
**/sessions/
**/cache/
