{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // Shared by Personal and JR. Each host backs Claude with its own account (Personal: personal, JR: company).
  // Follows the omo.dev/docs default chains; Fable is not on the $20 Claude plan, so Fable lanes start on Opus high.
  // Order per chain: Claude/GPT first, OpenCode Go ($10, limited) only as the last-resort tail.
  // When the Claude limit runs out, start omo with: OMO_PROFILE=gpt-main omo
  "model_profile": "opus-main",
  "model_profiles": {
    "opus-main": {
      "display_name": "Opus main",
      "family": "daily",
      "tier": "normal",
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-6.1-sol-fast", "reasoning": "high" }
      ]
    }
  },
  "profiles": {
    "gpt-main": { "model_profile": "geeky-normal" }
  },

  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },

  "categories": {
    "architect": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" }
      ]
    },
    "ultrabrain": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" }
      ]
    },
    "deep-high": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "high" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "deep-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    // Docs lead with Opus here; Sol leads to spare the $20 Claude quota.
    "unspecified-high": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "medium" },
        { "model": "opencode-go/glm-5.3", "reasoning": "max" }
      ]
    },
    // Docs lead with Sonnet here; Sol leads to spare the $20 Claude quota.
    "unspecified-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "opencode-go/mimo-v2.6-pro", "reasoning": "max" }
      ]
    },
    "visual-engineering": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/kimi-k3", "reasoning": "max" }
      ]
    },
    "artistry": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/kimi-k3", "reasoning": "max" }
      ]
    },
    "writing": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "low" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" }
      ]
    },
    "quick": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" }
      ]
    }
  },

  "agents": {
    "explore": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" }
      ]
    },
    "librarian": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" }
      ]
    },
    "plan-consultant": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" }
      ]
    },
    "plan-reviewer": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" }
      ]
    },
    "omo-native-qa-executor": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    }
  },

  "_migrations": [
    "2026-08-reasoning-unification",
    "2026-09-subscription-provider-rename"
  ]
}
