{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "model_profile": "chatgpt-subscription/gpt-6-sol:medium",
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "categories": {
    "architect": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6-sol", "reasoning": "high" }
      ]
    },
    "ultrabrain": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6-sol", "reasoning": "max" }
      ]
    },
    "deep-high": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-sol", "reasoning": "high" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" }
      ]
    },
    "deep-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-sol", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "unspecified-high": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "medium" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "off" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "visual-engineering": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "off" }
      ]
    },
    "artistry": {
      "models": [
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "off" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "medium" }
      ]
    },
    "writing": {
      "models": [
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "off" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "low" }
      ]
    },
    "quick": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna", "reasoning": "low" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" },
        { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "xhigh" }
      ]
    },
    "unspecified-low": {
      "models": [
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" },
        { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "xhigh" },
        { "model": "chatgpt-subscription/gpt-6-luna", "reasoning": "low" }
      ]
    }
  },
  "agents": {
    "explore": {
      "models": [
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" },
        { "model": "chatgpt-subscription/gpt-6-luna", "reasoning": "low" }
      ]
    },
    "librarian": {
      "models": [
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "off" }
      ]
    },
    "plan-consultant": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "off" }
      ]
    },
    "plan-reviewer": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6-sol", "reasoning": "high" }
      ]
    }
  },
  "task": {
    "default_concurrency": 8,
    "global_concurrency": 8,
    "residency_max_children": 8,
    "team": {
      "max_members": 8,
      "max_parallel_members": 8,
      "max_wall_clock_minutes": 120
    }
  },
  "profiles": {
    "pro100": {
      "categories": {
        "ultrabrain": {
          "models": [
            { "model": "chatgpt-subscription/gpt-6-sol", "reasoning": "max" },
            { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" }
          ]
        },
        "quick": {
          "models": [
            { "model": "chatgpt-subscription/gpt-6-luna", "reasoning": "low" },
            { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" },
            { "model": "opencode-go/muse-spark-1.3-contributor", "reasoning": "xhigh" }
          ]
        }
      },
      "agents": {
        "plan-reviewer": {
          "models": [
            { "model": "chatgpt-subscription/gpt-6-sol", "reasoning": "high" },
            { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" }
          ]
        }
      }
    }
  }
}
