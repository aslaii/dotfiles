{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // Main session driver: Opus 5.5 medium (same as omp's default role), GPT-6.1 Sol if Claude is not connected.
  // Claude quota is reserved for the main agent plus rare high-value calls (architect, plan-consultant, writing).
  // When the Claude weekly limit runs out, start omo with: OMO_PROFILE=gpt-main omo
  "model_profile": "opus-main",
  "model_profiles": {
    "opus-main": {
      "display_name": "Opus main",
      "family": "daily",
      "tier": "normal",
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-6.1-sol-fast", "reasoning": "high" }
      ]
    }
  },
  "profiles": {
    "gpt-main": { "model_profile": "geeky-normal" }
  },

  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },

  // Only Claude and GPT lead a chain; the single cheap tail is DeepSeek V4.1 Flash, GLM 5.3 Flash or Muse 1.3 Contributor.
  "categories": {
    // Planner: Opus high, then Astra xhigh. Reviewer-style lanes invert the order.
    "architect": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" }
      ]
    },
    "ultrabrain": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" }
      ]
    },
    // Executor: Sol leads code lanes to spare Claude quota for Opus; Sonnet leads Claude-shaped lanes.
    "deep-high": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "deep-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "unspecified-high": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "visual-engineering": {
      "models": [
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "command-code/meta/muse-spark-1.3-contributor" }
      ]
    },
    "artistry": {
      "models": [
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "command-code/meta/muse-spark-1.3-contributor" }
      ]
    },
    "writing": {
      "models": [
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "command-code/meta/muse-spark-1.3-contributor" }
      ]
    },
    // Low: Luna first, then Haiku, then the cheap tail.
    "unspecified-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna", "reasoning": "medium" },
        { "model": "anthropic-subscription/claude-haiku-5-5", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "quick": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "anthropic-subscription/claude-haiku-5-5", "reasoning": "low" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "low" }
      ]
    }
  },

  "agents": {
    "explore": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "anthropic-subscription/claude-haiku-5-5", "reasoning": "low" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "low" }
      ]
    },
    "librarian": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "anthropic-subscription/claude-haiku-5-5", "reasoning": "low" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "low" }
      ]
    },
    "plan-consultant": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" }
      ]
    },
    "plan-reviewer": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "xhigh" },
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" }
      ]
    },
    "omo-native-qa-executor": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    }
  },

  "_migrations": [
    "2026-08-reasoning-unification",
    "2026-09-subscription-provider-rename"
  ]
}
