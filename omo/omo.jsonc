{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "model_profile": "geeky-normal",
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "categories": {
    "architect": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "ultrabrain": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "deep-high": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "deep-low": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "unspecified-high": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "visual-engineering": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "artistry": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "writing": {
      "models": [
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "medium" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "low" }
      ]
    },
    "quick": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "low" }
      ]
    },
    "unspecified-low": {
      "models": [
        { "model": "anthropic-subscription/claude-sonnet-5-5", "reasoning": "medium" },
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "medium" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "low" }
      ]
    }
  },
  "agents": {
    "omo-native-qa-executor": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "medium" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "explore": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "low" }
      ]
    },
    "librarian": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-luna-fast", "reasoning": "low" },
        { "model": "opencode-go/glm-5.3-flash", "reasoning": "low" }
      ]
    },
    "omo-bonsai": {
      "models": [
        { "model": "bonsai-local/model" }
      ]
    },
    "plan-consultant": {
      "models": [
        { "model": "anthropic-subscription/claude-opus-5-5", "reasoning": "high" },
        { "model": "chatgpt-subscription/gpt-6.1-sol", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    },
    "plan-reviewer": {
      "models": [
        { "model": "chatgpt-subscription/gpt-6-astra", "reasoning": "high" },
        { "model": "opencode-go/deepseek-v4.1-flash", "reasoning": "high" }
      ]
    }
  },
  "task": {
    "default_concurrency": 8,
    "global_concurrency": 8,
    "residency_max_children": 8,
    "team": {
      "max_members": 8,
      "max_parallel_members": 8,
      "max_wall_clock_minutes": 120
    }
  }
}
