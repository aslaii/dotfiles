{
  "theme": "grok-night/dark",
  "configReload": {
    "watch": {
      "settings": false
    }
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail@4.9.0",
      "skills": [
        "!caveman-*",
        "!cavecrew"
      ]
    },
    "npm:@code-yeongyu/comment-checker@0.8.0",
    {
      "source": "git:github.com/code-yeongyu/pi-comment-checker@0a38dd8ff362be1b6020f2baba7b5723cbc5ea76",
      "extensions": []
    }
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "quietStartup": true,
  "hideThinkingBlock": false,
  "favoriteModels": [
    "openai-codex/gpt-5.6-sol",
    "opencode/muse-spark-1.3-contributor-free",
    "opencode-go/glm-5.3",
    "claude-sdk-oauth/claude-haiku-4-5",
    "claude-sdk-oauth/claude-sonnet-5",
    "openai-codex/gpt-5.6-luna-fast",
    "openai-codex/gpt-5.6-terra"
  ],
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-sol": "high",
    "google/gemini-3.1-pro-preview": "low",
    "openai-codex/gpt-5.6-sol-fast": "high",
    "opencode/muse-spark-1.3-contributor-free": "xhigh",
    "opencode-go/glm-5.3": "max",
    "claude-sdk-oauth/claude-haiku-4-5": "low",
    "claude-sdk-oauth/claude-sonnet-5": "medium",
    "openai-codex/gpt-5.6-luna-fast": "low",
    "openai-codex/gpt-5.6-terra": "medium"
  },
  "skills": [
    "!__OMO_HOME__/.agents/skills/**",
    "!__OMO_HOME__/.claude/skills/**",
    "!caveman-*",
    "!cavecrew"
  ],
  "permission": {
    "*": "allow"
  },
  "enabledModels": [
    "opencode/muse-spark-1.3-contributor-free",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-sol-fast",
    "openai-codex/gpt-5.4-mini",
    "opencode-go/glm-5.3",
    "claude-sdk-oauth/claude-haiku-4-5",
    "claude-sdk-oauth/claude-sonnet-5",
    "openai-codex/gpt-5.6-luna-fast",
    "openai-codex/gpt-5.6-terra"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "uiMode": "fullscreen",
  "modelServiceTiers": {
    "openai-codex/gpt-5.6-sol": "auto",
    "openai-codex/gpt-5.6-luna-fast": "priority"
  },
  "recommendedModels": [
    "gpt-5.6-sol",
    "muse-spark-1.3-contributor-free"
  ],
  "retry": {
    "enabled": true,
    "modelFallback": true,
    "fallbackRevertPolicy": "cooldown-expiry",
    "fallbackChains": {
      "opencode/muse-spark-1.3-contributor-free": [
        "openai-codex/gpt-5.6-terra:medium"
      ],
      "claude-sdk-oauth/claude-haiku-4-5": [
        "opencode/muse-spark-1.3-contributor-free:xhigh",
        "openai-codex/gpt-5.6-luna-fast:low"
      ],
      "openai-codex/gpt-5.6-luna-fast": [
        "opencode/muse-spark-1.3-contributor-free:xhigh"
      ],
      "claude-sdk-oauth/claude-sonnet-5": [
        "opencode/muse-spark-1.3-contributor-free:xhigh",
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-sol:high"
      ],
      "openai-codex/gpt-5.6-terra": [
        "openai-codex/gpt-5.6-sol:high",
        "opencode/muse-spark-1.3-contributor-free:xhigh"
      ],
      "openai-codex/gpt-5.6-sol": [
        "opencode/muse-spark-1.3-contributor-free:xhigh"
      ],
      "openai-codex/gpt-5.6-sol-fast": [
        "openai-codex/gpt-5.6-sol:high",
        "opencode/muse-spark-1.3-contributor-free:xhigh"
      ],
      "openai-codex/gpt-5.4-mini": [
        "openai-codex/gpt-5.6-luna-fast:low",
        "opencode/muse-spark-1.3-contributor-free:xhigh"
      ],
      "openai-codex/gpt-5.5": [
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-sol:high",
        "opencode/muse-spark-1.3-contributor-free:xhigh"
      ],
      "opencode-go/glm-5.3": [
        "opencode/muse-spark-1.3-contributor-free:xhigh",
        "claude-sdk-oauth/claude-sonnet-5:medium",
        "openai-codex/gpt-5.6-terra:medium",
        "opencode/muse-spark-1.3-contributor-free:xhigh"
      ]
    }
  },
  "claudeSdkOauthProvider": {
    "enabled": true
  }
}
