{
  "theme": "grok-night/dark",
  "configReload": {
    "watch": {
      "settings": false
    }
  },
  "defaultProvider": "chatgpt-subscription",
  "defaultModel": "gpt-6.1-sol-fast",
  "defaultThinkingLevel": "medium",
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail@4.9.0",
      "skills": [
        "!caveman-*",
        "!cavecrew"
      ]
    },
    {
      "source": "git:github.com/JuliusBrussee/caveman@v2.6.0",
      "skills": [
        "caveman"
      ]
    },
    "npm:@code-yeongyu/comment-checker@0.8.0",
    {
      "source": "git:github.com/code-yeongyu/pi-comment-checker@0a38dd8ff362be1b6020f2baba7b5723cbc5ea76",
      "extensions": []
    }
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "quietStartup": true,
  "hideThinkingBlock": false,
  "favoriteModels": [
    "chatgpt-subscription/gpt-6.1-sol-fast",
    "chatgpt-subscription/gpt-6-luna-fast",
    "chatgpt-subscription/gpt-6.1-sol",
    "chatgpt-subscription/gpt-6-luna",
    "chatgpt-subscription/gpt-6-astra",
    "anthropic-subscription/claude-opus-5-5"
  ],
  "modelThinkingLevels": {
    "chatgpt-subscription/gpt-6.1-sol": "medium",
    "chatgpt-subscription/gpt-6-luna": "low",
    "chatgpt-subscription/gpt-6-astra": "high",
    "anthropic-subscription/claude-opus-5-5": "medium",
    "chatgpt-subscription/gpt-6.1-sol-fast": "medium",
    "chatgpt-subscription/gpt-6-luna-fast": "low"
  },
  "skills": [
    "!__OMO_HOME__/.agents/skills/**",
    "!__OMO_HOME__/.claude/skills/**",
    "!caveman-*",
    "!cavecrew"
  ],
  "permission": {
    "*": "allow"
  },
  "enabledModels": [
    "chatgpt-subscription/gpt-6.1-sol",
    "chatgpt-subscription/gpt-6-luna",
    "chatgpt-subscription/gpt-6-astra",
    "anthropic-subscription/claude-opus-5-5",
    "opencode/space-bunny-free",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/glm-5.3-flash",
    "nvidia/z-ai/glm-5.3-flash",
    "command-code/stealth/space-bunny-alpha",
    "chatgpt-subscription/gpt-6.1-sol-fast",
    "chatgpt-subscription/gpt-6-luna-fast",
    "anthropic-subscription/claude-sonnet-5-5"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "uiMode": "fullscreen",
  "modelServiceTiers": {
    "chatgpt-subscription/gpt-6.1-sol": "priority",
    "chatgpt-subscription/gpt-6-luna": "priority",
    "chatgpt-subscription/gpt-6-astra": "auto"
  },
  "compaction": {
    "modelOverrides": {
      "bonsai-local/model": {
        "reserveTokens": 2048,
        "keepRecentTokens": 4096
      }
    }
  },
  "recommendedModels": [
    "gpt-6.1-sol-fast"
  ],
  "retry": {
    "enabled": true,
    "modelFallback": true,
    "fallbackRevertPolicy": "cooldown-expiry",
    "fallbackChains": {
      "chatgpt-subscription/gpt-6.1-sol": [
        "anthropic-subscription/claude-opus-5-5:medium"
      ],
      "chatgpt-subscription/gpt-6.1-sol-fast": [
        "anthropic-subscription/claude-opus-5-5:medium"
      ],
      "chatgpt-subscription/gpt-6-astra": [
        "opencode-go/deepseek-v4.1-flash:high"
      ],
      "chatgpt-subscription/gpt-6-luna": [
        "opencode-go/glm-5.3-flash:low"
      ],
      "chatgpt-subscription/gpt-6-luna-fast": [
        "opencode-go/glm-5.3-flash:low"
      ],
      "anthropic-subscription/claude-opus-5-5": [
        "chatgpt-subscription/gpt-6.1-sol:high",
        "opencode-go/deepseek-v4.1-flash:high"
      ],
      "anthropic-subscription/claude-sonnet-5-5": [
        "chatgpt-subscription/gpt-6-luna-fast:medium",
        "opencode-go/glm-5.3-flash:low"
      ]
    }
  },
  "claudeSdkOauthProvider": {
    "enabled": true
  }
}
