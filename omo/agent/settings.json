{
  "theme": "grok-night/dark",
  "configReload": {
    "watch": {
      "settings": false
    }
  },
  "defaultProvider": "anthropic-subscription",
  "defaultModel": "claude-sonnet-5",
  "defaultThinkingLevel": "medium",
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail@4.9.0",
      "skills": [
        "!caveman-*",
        "!cavecrew"
      ]
    },
    {
      "source": "git:github.com/JuliusBrussee/caveman@v2.6.0",
      "skills": [
        "caveman"
      ]
    },
    "npm:@code-yeongyu/comment-checker@0.8.0",
    {
      "source": "git:github.com/code-yeongyu/pi-comment-checker@0a38dd8ff362be1b6020f2baba7b5723cbc5ea76",
      "extensions": []
    }
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "quietStartup": true,
  "hideThinkingBlock": false,
  "favoriteModels": [
    "anthropic-subscription/claude-sonnet-5",
    "anthropic-subscription/claude-opus-5-5",
    "chatgpt-subscription/gpt-6-sol",
    "chatgpt-subscription/gpt-6-luna",
    "chatgpt-subscription/gpt-6-astra",
    "commandcode/deepseek/deepseek-v4.1-flash",
    "commandcode/z-ai/glm-5.3-flash",
    "commandcode/meta/muse-spark-1.3-contributor"
  ],
  "modelThinkingLevels": {
    "anthropic-subscription/claude-sonnet-5": "medium",
    "chatgpt-subscription/gpt-6-sol": "medium",
    "chatgpt-subscription/gpt-6-luna": "low",
    "chatgpt-subscription/gpt-6-astra": "high",
    "anthropic-subscription/claude-opus-5-5": "medium",
    "commandcode/deepseek/deepseek-v4.1-flash": "high",
    "commandcode/z-ai/glm-5.3-flash": "high",
    "commandcode/meta/muse-spark-1.3-contributor": "xhigh"
  },
  "skills": [
    "!__OMO_HOME__/.agents/skills/**",
    "!__OMO_HOME__/.claude/skills/**",
    "!caveman-*",
    "!cavecrew"
  ],
  "permission": {
    "*": "allow"
  },
  "enabledModels": [
    "anthropic-subscription/claude-sonnet-5",
    "chatgpt-subscription/gpt-6-sol",
    "chatgpt-subscription/gpt-6-luna",
    "chatgpt-subscription/gpt-6-astra",
    "anthropic-subscription/claude-opus-5-5",
    "commandcode/deepseek/deepseek-v4.1-flash",
    "commandcode/z-ai/glm-5.3-flash",
    "commandcode/meta/muse-spark-1.3-contributor"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "uiMode": "fullscreen",
  "modelServiceTiers": {
    "chatgpt-subscription/gpt-6-sol": "auto",
    "chatgpt-subscription/gpt-6-luna": "auto",
    "chatgpt-subscription/gpt-6-astra": "auto"
  },
  "recommendedModels": [
    "claude-sonnet-5"
  ],
  "retry": {
    "enabled": true,
    "modelFallback": true,
    "fallbackRevertPolicy": "cooldown-expiry",
    "fallbackChains": {
      "anthropic-subscription/claude-sonnet-5": [
        "anthropic-subscription/claude-opus-5-5:medium"
      ],
      "anthropic-subscription/claude-opus-5-5": []
    }
  },
  "claudeSdkOauthProvider": {
    "enabled": true
  }
}
