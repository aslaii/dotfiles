{
  "theme": "grok-night/dark",
  "configReload": {
    "watch": {
      "settings": false
    }
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:@dietrichgebert/ponytail@4.9.0",
    "npm:@code-yeongyu/comment-checker@0.8.0",
    "git:github.com/code-yeongyu/pi-comment-checker@0a38dd8ff362be1b6020f2baba7b5723cbc5ea76"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "quietStartup": true,
  "hideThinkingBlock": false,
  "favoriteModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-luna-fast",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-haiku-4-5",
    "anthropic/claude-sonnet-5"
  ],
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-luna": "xhigh",
    "anthropic/claude-opus-5": "medium",
    "openai-codex/gpt-5.6-sol": "high",
    "openai-codex/gpt-5.6-terra": "xhigh",
    "google/gemini-3.1-pro-preview": "low",
    "openai-codex/gpt-5.6-sol-fast": "high",
    "anthropic/claude-sonnet-5": "high",
    "openai-codex/gpt-5.6-luna-fast": "low",
    "openai-codex/gpt-6-astra": "xhigh"
  },
  "skills": [
    "~/.codex/skills",
    "~/.agents/skills"
  ],
  "permission": {
    "*": "allow"
  },
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-luna-fast",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-sol-fast",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-haiku-4-5",
    "anthropic/claude-sonnet-5",
    "openai-codex/gpt-5.4-mini"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "uiMode": "fullscreen",
  "modelServiceTiers": {
    "openai-codex/gpt-5.6-sol": "priority"
  },
  "recommendedModels": [
    "gpt-6-astra",
    "gpt-5.6-sol",
    "gpt-5.6-terra"
  ],
  "retry": {
    "enabled": true,
    "modelFallback": true,
    "fallbackRevertPolicy": "never",
    "fallbackChains": {
      "openai-codex/gpt-6-astra": [
        "openai-codex/gpt-5.6-sol:high",
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "openai-codex/gpt-5.6-luna": [
        "openai-codex/gpt-5.6-sol:high",
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "openai-codex/gpt-5.6-luna-fast": [
        "openai-codex/gpt-5.4-mini:low"
      ],
      "openai-codex/gpt-5.6-sol": [
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "openai-codex/gpt-5.6-sol-fast": [
        "openai-codex/gpt-5.6-sol:high",
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "openai-codex/gpt-5.6-terra": [
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "anthropic/claude-haiku-4-5": [
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "anthropic/claude-sonnet-5": [
        "openai-codex/gpt-5.6-sol:high",
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "openai-codex/gpt-5.4-mini": [],
      "openai-codex/gpt-5.5": [
        "openai-codex/gpt-5.6-sol:high",
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ],
      "openai-codex/gpt-5.6-terra-fast": [
        "openai-codex/gpt-5.6-sol:high",
        "openai-codex/gpt-5.6-terra:high",
        "openai-codex/gpt-5.6-luna-fast:low",
        "openai-codex/gpt-5.4-mini:low"
      ]
    }
  }
}
