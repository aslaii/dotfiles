# macos/zsh/zshrc

# --- Environment Flags ---
IS_MAC=true
IS_LINUX=false
IS_WSL=false

# Codex opens one pipe set per MCP server; macOS defaults to only 256 files.
ulimit -n 61440 2>/dev/null

# --- Path Setup ---
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"

# --- Zinit Plugin Manager ---
if [ ! -f "$HOME/.zinit/bin/zinit.zsh" ]; then
  mkdir -p "$HOME/.zinit"
  git clone https://github.com/zdharma-continuum/zinit.git "$HOME/.zinit/bin"
fi
source "$HOME/.zinit/bin/zinit.zsh"

# --- Plugins ---
zinit ice wait lucid
zinit light zsh-users/zsh-autosuggestions

zinit ice wait lucid atload"bindkey '^[[A' history-substring-search-up; bindkey '^[[B' history-substring-search-down"
zinit light zsh-users/zsh-history-substring-search

# Syntax highlighting MUST load last (synchronous, not Turbo)
zinit light zdharma-continuum/fast-syntax-highlighting

# --- Source Aliases and Functions ---
[ -f "$HOME/.zsh/aliases.zsh" ] && source "$HOME/.zsh/aliases.zsh"
[ -f "$HOME/.zsh/functions.zsh" ] && source "$HOME/.zsh/functions.zsh"

set_shell_theme

# --- FZF & Bat ---
if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_OPTS='--prompt="🔭 " --height 80% --layout=reverse --border'
  export FZF_DEFAULT_COMMAND='rg --files --no-ignore --hidden --follow --glob "!.git/" --glob "!node_modules/" --glob "!vendor/" --glob "!undo/" --glob "!plugged/"'
  bindkey '^R' fzf-history-widget
  fzf-history-widget() {
    local selected
    selected=$(fc -l 1 | awk '{$1=""; print substr($0,2)}' | fzf --tac +s --query="$LBUFFER")
    if [[ -n $selected ]]; then
      LBUFFER=$selected
      zle redisplay
    fi
  }
  zle -N fzf-history-widget
fi

# --- Zoxide ---
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# --- fnm (Node) ---
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd)"
fi

# --- pnpm ---
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# --- bun completions ---
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
