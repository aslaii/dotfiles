!gemini/antigravity/mcp_config.template.json
gemini/antigravity-browser-profile/

# Node
node_modules/
**/node_modules/

# Local editor/runtime artifacts
.nvimlog
nvim/nvim

# Personal files (never commit)
Jericho Bermas - CV.pdf

# Claude Code local state (.claude/ at repo root holds git worktree metadata)
.claude/

# Claude Code runtime artifacts
claude/sessions/
claude/.statusline-usage-cache
claude/gsd-user-files-backup/

# Claude usage fetcher — contains hardcoded session key, never commit
claude/fetch-claude-usage.swift

# GSD per-project runtime contexts (auto-generated)
claude/get-shit-done/contexts/
opencode/get-shit-done/contexts/

# Backup files from migration tooling
*.tui-migration.bak

# GSD planning directory (workflow metadata, not tracked in this repo)
.planning/

# MCP runtime auth cache
claude/mcp-needs-auth-cache.json

# Project-local MCP config (machine-specific absolute paths / may contain tokens)
.mcp.json

# GSD agent runtime state
.gsd/
