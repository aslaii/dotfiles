# Only portable configuration, authored skills, and plugin manifests belong here.
*
!.gitignore
!launch.mjs
!isolation.test.js
!fast.test.js
!fast.yml
!budget.yml
!no-claude.yml
!fast.mjs
!preload.mjs
!README.md
!agent/
!agent/config.yml
!agent/models.yml
!agent/APPEND_SYSTEM.md
!agent/agents/
!agent/agents/*.md
!agent/skills/
!agent/skills/**
!agent/rules/
!agent/rules/**
!plugins/
!plugins/package.json
!plugins/bun.lock
!plugins/omp-plugins.lock.json

# Never vendor dependencies or authentication/runtime state inside skills.
**/node_modules/
**/.env*
**/auth.json
**/*.db*
