# ======================================================================================
# Basic yabai shortcuts designed for a first-time tiling window manager user.
# The bindings lean on familiar Vim-style navigation (h/j/k/l) and keep the
# modifier set to left alt so they are easy to remember.
#
# Focus     : alt + {h,j,k,l}
# Move/swap : shift + alt + {h,j,k,l}
# Resize    : ctrl + alt + {h,j,k,l}
# Extras    : alt + space (float), alt + f (fullscreen), alt + r (reload)
# ======================================================================================

# --- Focus windows using Vim motions ---------------------------------------------
alt - h : yabai -m window --focus west  || yabai -m display --focus west
alt - j : yabai -m window --focus south || yabai -m display --focus south
alt - k : yabai -m window --focus north || yabai -m display --focus north
alt - l : yabai -m window --focus east  || yabai -m display --focus east

# --- Swap the focused window with its neighbour -----------------------------------
shift + alt - h : yabai -m window --swap west  || (yabai -m window --display west  && yabai -m display --focus west)
shift + alt - j : yabai -m window --swap south || (yabai -m window --display south && yabai -m display --focus south)
shift + alt - k : yabai -m window --swap north || (yabai -m window --display north && yabai -m display --focus north)
shift + alt - l : yabai -m window --swap east  || (yabai -m window --display east  && yabai -m display --focus east)

# --- Resize the focused window ----------------------------------------------------
ctrl + alt - h : yabai -m window --resize right:-120:0  || yabai -m window --resize left:-120:0
ctrl + alt - j : yabai -m window --resize bottom:0:120 || yabai -m window --resize top:0:120
ctrl + alt - k : yabai -m window --resize bottom:0:-120 || yabai -m window --resize top:0:-120
ctrl + alt - l : yabai -m window --resize right:120:0  || yabai -m window --resize left:120:0
ctrl + alt - e : yabai -m space --balance

# --- Handy toggles ---------------------------------------------------------------
alt - space : yabai -m window --toggle float
alt - f     : yabai -m window --toggle zoom-fullscreen
alt - r     : (yabai --restart || pkill -USR1 yabai) && skhd -r

# --- Launch a terminal quickly ----------------------------------------------------
cmd - return : osascript -e 'tell application "Ghostty" to create window with default profile command ""' || open -na Ghostty
